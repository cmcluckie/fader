<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe suppresses a console window when launched from an .app bundle;
         it is a no-op on macOS otherwise. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fader.MenuBar</RootNamespace>
    <AssemblyName>FaderBridgeMenuBar</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- managed-midi (via the referenced bridge) marks IMidiAccess obsolete. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the real, tested bridge in-process rather than re-linking sources. -->
    <ProjectReference Include="..\FaderBridge\FaderBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- config.json is provided by the referenced FaderBridge project, which
         already copies it to output; a second copy here collides on publish. -->
  </ItemGroup>

</Project>
