<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plumbing the app needs and no feature owns: the OSC codec and the
       drawn-control toolkit. Nothing here knows what feedback is. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fader.Shared</RootNamespace>
    <AssemblyName>Fader.Shared</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both apps pin 11.2.1; the shared controls must not drag them forward. -->
    <PackageReference Include="Avalonia" Version="11.2.1" />
  </ItemGroup>

</Project>
