{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Fader.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "self-test",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/diagnostics/BridgeSelfTest"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "list MIDI ports",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/diagnostics/MidiMonitor"],
      "problemMatcher": "$msCompile"
    }
  ]
}
