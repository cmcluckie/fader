{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Feedback Fader (from source)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/FeedbackFader.App/bin/Debug/net8.0/FeedbackFader.dll",
      "cwd": "${workspaceFolder}/src/FeedbackFader.App",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Feedback self-test (no hardware; nothing on the desk is written)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/diagnostics/FeedbackSelfTest/bin/Debug/net8.0/FeedbackSelfTest.dll",
      "cwd": "${workspaceFolder}/diagnostics/FeedbackSelfTest",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
