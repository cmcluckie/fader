<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fader.Diagnostics.OscPing</RootNamespace>
    <AssemblyName>OscPing</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link the shared OSC codec rather than copying it, so this diagnostic
         exercises the same code both apps run on. -->
    <Compile Include="..\..\src\Fader.Shared\Osc\OscMessage.cs" Link="Osc\OscMessage.cs" />
  </ItemGroup>

</Project>
