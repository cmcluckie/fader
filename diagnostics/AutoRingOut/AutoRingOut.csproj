<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fader.Diagnostics.AutoRingOut</RootNamespace>
    <AssemblyName>AutoRingOut</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console's own RTA and the OSC codec. Deliberately NOT FaderBridge:
         this is a Feedback Fader measurement and must not need the bridge. -->
    <ProjectReference Include="..\..\src\FeedbackFader.Core\FeedbackFader.Core.csproj" />
    <ProjectReference Include="..\..\src\Fader.Shared\Fader.Shared.csproj" />
  </ItemGroup>

</Project>
